{
    "name": "jeffersongoncalves/laravel-ccpa-risk-assessments",
    "description": "CCPA/CPRA risk assessments for Laravel (CCPA Regulations Article 10): risks scored by likelihood and impact, safeguards and residual risk, approval, three-year review, CPPA submission and the processing activities that need one.",
    "keywords": [
        "laravel",
        "ccpa",
        "cpra",
        "risk-assessment",
        "cppa",
        "privacy",
        "linddun"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-ccpa-risk-assessments",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "jeffersongoncalves/laravel-ccpa": "^2.0",
        "jeffersongoncalves/laravel-ccpa-notices": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "jeffersongoncalves/pest-plugin-database-migrations": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\CcpaRiskAssessments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\CcpaRiskAssessments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\CcpaRiskAssessments\\CcpaRiskAssessmentsServiceProvider"
            ],
            "aliases": {
                "CcpaRiskAssessments": "JeffersonGoncalves\\CcpaRiskAssessments\\Facades\\CcpaRiskAssessments"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
